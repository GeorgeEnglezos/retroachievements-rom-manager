<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- ROM scanning reads arbitrary user-chosen folders with raw dart:io paths
         (same model as desktop). "All files access" is the only way to keep that
         working on Android 11+; the app is sideloaded (GitHub releases, not Play
         Store), so the Play policy on this permission does not apply. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <!-- List installed emulator apps and launch a ROM in the one the user picked.
         Android 11+ hides other packages by default; the app is sideloaded (not
         Play Store) so the Play policy on this permission does not apply. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>
    <!-- Kill an emulator's stale background process before relaunching it: some
         emulators (RetroArch) are single-instance and just show a black screen
         when handed a new ROM while already running. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES"/>
    <!-- Short name: the launcher truncates anything near the full
         "Retroachievements Rom Manager". -->
    <!-- allowBackup defaults to true, which would put shared_prefs (and the
         Keystore-encrypted API key, which is undecryptable on a different
         device) into Google Drive auto-backup. Nothing here is worth
         restoring: the library is re-scanned from local files anyway. -->
    <application
        android:label="RARM"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Hands ROM files to emulator apps as content:// URIs (raw file:// is
             blocked since Android 7). root-path covers any absolute ROM path,
             including SD cards under /storage/XXXX-XXXX. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
